@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-title">
            <span class="app-mark"></span>
            <span>Ising model simulator</span>
            <a class="app-byline" href="https://francisco-kim.github.io"
               target="_blank" rel="noopener">by Francisco Kim</a>
        </div>
        <nav class="app-nav">
            <NavLink href="" Match="NavLinkMatch.All">Simulator</NavLink>
            <NavLink href="sweep">Observables</NavLink>
            <NavLink href="hysteresis">Hysteresis</NavLink>
            <NavLink href="renormalisation">Renormalisation</NavLink>
            <NavLink href="central-charge">Central charge</NavLink>
            <NavLink href="xy">XY model</NavLink>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        2D/1D Ising model Monte Carlo — Metropolis, Glauber and Wolff dynamics.
        Runs entirely in your browser.
        <a href="https://github.com/francisco-kim/IsingSimulator" target="_blank" rel="noopener">Source</a>
    </footer>
</div>
