@page "/xy"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>XY model — Kosterlitz–Thouless transition</PageTitle>

<div class="sim-layout">
    <section class="lattice-panel">
        <div class="canvas-stack">
            <canvas id="xy-canvas" class="lattice-canvas"></canvas>
            <canvas id="xy-arrows" class="lattice-overlay"></canvas>
        </div>
        <div class="readout-row">
            <div class="readout"><span class="readout-label">|m|</span><span class="readout-value">@_magnetisation.ToString("0.000")</span></div>
            <div class="readout"><span class="readout-label">E per spin</span><span class="readout-value">@_energyPerSite.ToString("0.000")</span></div>
            <div class="readout"><span class="readout-label">vortices ○</span><span class="readout-value">@_vortexCount</span></div>
            <div class="readout"><span class="readout-label">antivortices ●</span><span class="readout-value">@_antivortexCount</span></div>
            <div class="readout"><span class="readout-label">sweeps</span><span class="readout-value">@_completedSweeps.ToString("0")</span></div>
            <div class="readout"><span class="readout-label">sweeps/s</span><span class="readout-value">@_sweepsPerSecond.ToString("0.0")</span></div>
        </div>
    </section>

    <aside class="controls">
        <div class="control-group control-buttons">
            <button class="btn btn-primary" @onclick="TogglePlay">@(_running ? "Pause" : "Run")</button>
            <button class="btn" @onclick="StepOnce" disabled="@_running">Step</button>
            <button class="btn" @onclick="ResetLattice">Reset</button>
        </div>

        <div class="control-group">
            <label class="control-label">Temperature T = @_temperature.ToString("0.000")</label>
            <input type="range" min="0.05" max="2.5" step="0.005"
                   value="@_temperature"
                   @oninput="@(e => _temperature = double.Parse((string)e.Value!))" />
            <div class="slider-scale"><span>0.05</span><span class="tc-tick" style="left:@KtSliderPercent%">▲ T<sub>KT</sub></span><span>2.5</span></div>
        </div>

        <div class="control-group">
            <label class="control-label">Explore the KT transition (T<sub>KT</sub> ≈ 0.893)</label>
            <div class="inline-controls">
                <button class="btn btn-mini" @onclick="() => _temperature = 0.4">0.40 — deep quasi-order</button>
                <button class="btn btn-mini" @onclick="() => _temperature = 0.85">0.85 — just below</button>
                <button class="btn btn-mini" @onclick="() => _temperature = 0.95">0.95 — just above</button>
                <button class="btn btn-mini" @onclick="() => _temperature = 1.2">1.20 — free vortices</button>
                <button class="btn btn-mini" @onclick="() => _temperature = 1.6">1.60 — hot</button>
            </div>
            <div class="control-hint">
                Below T<sub>KT</sub>: few vortex–antivortex pairs, tightly bound. Above: pairs unbind and
                free vortices proliferate.
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">Lattice &amp; speed</label>
            <div class="inline-controls">
                <select value="@_latticeLength" @onchange="OnSizeChanged">
                    <option value="64">64 × 64</option>
                    <option value="128">128 × 128</option>
                    <option value="256">256 × 256</option>
                </select>
                <select value="@(_hotStart ? "true" : "false")" @onchange="OnInitChanged"
                        title="Hot start: random angles (T = ∞). Cold start: all spins aligned (T = 0).">
                    <option value="true">hot start</option>
                    <option value="false">cold start</option>
                </select>
                <select value="@_sweepsPerFrame" @onchange="@(e => _sweepsPerFrame = double.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture))">
                    <option value="0.02">0.02 sweeps/frame (slowest)</option>
                    <option value="0.05">0.05 sweeps/frame</option>
                    <option value="0.1">0.1 sweeps/frame</option>
                    <option value="0.25">0.25 sweeps/frame</option>
                    <option value="0.5">0.5 sweeps/frame</option>
                    <option value="1">1 sweep/frame</option>
                    <option value="4">4 sweeps/frame</option>
                    <option value="16">16 sweeps/frame</option>
                </select>
            </div>
        </div>

        <div class="control-group">
            <label class="check-label">
                <input type="checkbox" @bind="_showVortices" @bind:after="RenderLattice" />
                mark vortices ○ / antivortices ●
            </label>
            <label class="check-label">
                <input type="checkbox" @bind="_showArrows" @bind:after="OnToggleArrows" />
                spin arrows around vortices
            </label>
        </div>

        <div class="control-group">
            <button class="btn" @onclick="ExportPng">Export PNG</button>
        </div>
    </aside>
</div>

<section class="charts-row">
    <StripChart Title="Spin-vector modulus |m|(t)" TitleMath="\text{Spin-vector modulus } |m|(t)"
                XValues="@_sweepAxis" YValues="@_magnetisationSeries"
                Stroke="var(--series-1)" FixedMin="0" FixedMax="1.05" />
    <StripChart Title="Vortex count (t)" TitleMath="\text{Vortex count } (t)"
                XValues="@_sweepAxis" YValues="@_vortexSeries"
                Stroke="var(--series-8)" FixedMin="0" />
</section>

<section class="explainer">
    <h2>What is being simulated?</h2>
    <p>
        The XY model replaces the Ising ±1 spins with planar unit vectors — an angle
        <span data-katex="\theta_i \in [0, 2\pi)"></span> at every site, shown as hue. The energy is
    </p>
    <div data-katex="H \;=\; -J \sum_{\langle i,j \rangle} \cos(\theta_i - \theta_j) ," data-katex-display></div>
    <p>
        with <span data-katex="J > 0"></span> favouring aligned neighbours. Because the symmetry is now
        continuous, the 2D model cannot magnetise at any <span data-katex="T > 0"></span>
        (Mermin–Wagner theorem) — yet it still has a phase transition, of a subtler, topological kind:
        the <strong>Berezinskii–Kosterlitz–Thouless (KT) transition</strong> at
        <span data-katex="k_{\mathrm{B}} T_{\mathrm{KT}} \approx 0.893\, J"></span>.
    </p>
    <p>
        The actors are <strong>vortices</strong> — points around which the phase winds by
        <span data-katex="+2\pi"></span> (marked ○) — and <strong>antivortices</strong>
        (winding <span data-katex="-2\pi"></span>, marked ●). The topological charge enclosed by a closed
        loop <span data-katex="C"></span> is the winding of the phase around it,
    </p>
    <div data-katex="q \;=\; \frac{1}{2\pi} \oint_{C} \nabla\theta \cdot \mathrm{d}\boldsymbol{\ell} \;\in\; \mathbb{Z} ,"
         data-katex-display></div>
    <p>
        which on the lattice becomes a sum over the four bonds of each elementary plaquette:
    </p>
    <div data-katex="q \;=\; \frac{1}{2\pi} \sum_{\langle i,j\rangle \,\in\, \square} \big[\, \theta_j - \theta_i \,\big]_{(-\pi,\,\pi]} \;\in\; \{-1,\, 0,\, +1\} ,"
         data-katex-display></div>
    <p>
        where the four bonds <span data-katex="\langle i,j\rangle"></span> are traversed counterclockwise
        around the plaquette and <span data-katex="[\,\cdot\,]_{(-\pi,\,\pi]}"></span> wraps each angle
        difference into <span data-katex="(-\pi,\,\pi]"></span>; then
        <span data-katex="q = +1"></span> marks a vortex, <span data-katex="q = -1"></span> an antivortex,
        and <span data-katex="q = 0"></span> an ordinary point. Below
        <span data-katex="T_{\mathrm{KT}}"></span> vortices occur only as rare, tightly bound
        vortex–antivortex pairs, and spin correlations decay slowly, as power laws (quasi-long-range
        order — the hue drifts smoothly across the lattice). Above
        <span data-katex="T_{\mathrm{KT}}"></span> the pairs unbind: free vortices proliferate, scramble
        the phase, and correlations collapse to exponential decay. Try the four preset temperatures and
        watch the vortex counter: it stays near zero, then jumps by orders of magnitude across the
        transition. On this periodic lattice the total winding must vanish, so the two counters always
        balance — vortices are created and destroyed strictly in pairs.
    </p>

    <h2>Why are vortices stable? A topological argument</h2>
    <p>
        A vortex cannot be smoothed away by any local wiggle of the spins, and the reason is
        topological rather than energetic. The order parameter of the XY model is an angle
        <span data-katex="\theta"></span> — that is, a point on the circle
        <span data-katex="S^1"></span> — so a whole configuration is a smooth map
        <span data-katex="\varphi : \mathbb{R}^2 \to S^1"></span> from the plane to that circle.
        Encircle a suspected defect by a closed loop <span data-katex="C"></span>. Walking once around
        <span data-katex="C"></span>, the angle traces a path on the target circle and must come back
        to itself up to a multiple of <span data-katex="2\pi"></span>; the number of times it wraps,
    </p>
    <div data-katex="q \;=\; \frac{1}{2\pi} \oint_{C} \nabla\theta \cdot \mathrm{d}\boldsymbol{\ell} \;\in\; \mathbb{Z} ,"
         data-katex-display></div>
    <p>
        is the same winding number as before, and it <em>cannot change under any continuous
        deformation of the field</em>. To alter <span data-katex="q"></span> you would have to unwind
        the angle somewhere — forcing the field through a configuration where
        <span data-katex="\theta"></span> is undefined (the modulus
        <span data-katex="|m| \to 0"></span> at the core, a finite-energy barrier) — or drag the
        defect out through the boundary. An infinitesimal change of the spins leaves
        <span data-katex="q"></span> untouched, so a vortex carries a conserved integer charge and is
        stable. That is exactly what <strong>topologically protected</strong> means: stability
        guaranteed by an integer that continuity cannot change, independent of the details of the
        energy.
    </p>
    <p>
        These integers are not ad hoc — they are the elements of the first homotopy group (the
        fundamental group) of the target space,
    </p>
    <div data-katex="\pi_1\!\left(S^1\right) \;=\; \mathbb{Z} ." data-katex-display></div>
    <p>
        The group <span data-katex="\pi_1(X)"></span> classifies loops in a space
        <span data-katex="X"></span> up to continuous deformation; for the circle a loop is labelled
        by how many times it winds, and windings add when loops are composed — hence
        <span data-katex="\mathbb{Z}"></span>. Restricting the field to the loop gives a map
        <span data-katex="\varphi|_C : C \to S^1"></span>, itself a loop in the target circle, and its
        homotopy class is precisely <span data-katex="q"></span>. Vortices
        (<span data-katex="q = +1"></span>), antivortices (<span data-katex="q = -1"></span>) and the
        ordinary point (<span data-katex="q = 0"></span>) are simply the first few classes.
    </p>
    <p>
        Written this way the classification is strikingly general: for <em>any</em> smooth map
        <span data-katex="\varphi : \mathbb{R}^n \to S^1"></span> the defects are labelled by the same
        integers, and three features are worth separating out.
    </p>
    <ul class="explainer-list">
        <li>
            <strong>The ambient dimension <span data-katex="n"></span> is irrelevant to the
            classification.</strong> What supplies the labels is the <em>target</em> space
            <span data-katex="S^1"></span>, through <span data-katex="\pi_1(S^1) = \mathbb{Z}"></span>;
            whether the spins live on a plane (<span data-katex="n = 2"></span>), throughout a 3D
            solid, or along a line does not change the group.
        </li>
        <li>
            <strong>We probe a defect with loops.</strong> Drawing a loop (a 1-sphere
            <span data-katex="S^1"></span>) around it and reading off the homotopy class of the
            restricted map is what detects the charge — and because it is one-dimensional loops that
            do the probing, it is <span data-katex="\pi_1"></span> of the target, not
            <span data-katex="\pi_0"></span> or <span data-katex="\pi_2"></span>, that classifies these
            defects.
        </li>
        <li>
            <strong>The defect's own dimension is bookkeeping.</strong> In
            <span data-katex="\mathbb{R}^2"></span> a loop bounds a disc, so the object it can trap is
            a point: the defect here is a <strong>0-dimensional point vortex</strong>, exactly what is
            marked on the lattice. The same encircling loop in
            <span data-katex="\mathbb{R}^3"></span> instead threads a one-dimensional vortex line — in
            general a codimension-2 object.
        </li>
    </ul>
    <p>
        So these vortices are stable for the same reason a knot tied in a closed loop of string cannot
        be undone without cutting: a discrete, integer-valued invariant stands in the way, and no
        infinitesimal — indeed no continuous — local change can step across it.
    </p>
</section>

@code {
    private const int SeriesCapacity = 400;
    private const int ArrowCanvasSize = 1024;
    private const int VortexArrowRadius = 6;
    private const int MaxVortexArrows = 8000;

    // Interleaved (xPixel, yPixel, theta) per arrow, filled each frame.
    private readonly double[] _vortexArrowData = new double[MaxVortexArrows * 3];
    private readonly HashSet<int> _arrowSitesSeen = new();
    private int _vortexArrowCount;
    private readonly LatticeRenderer _renderer = new();
    private readonly List<int> _vortexSites = new();
    private readonly List<int> _antivortexSites = new();
    private readonly List<double> _sweepAxis = new();
    private readonly List<double> _magnetisationSeries = new();
    private readonly List<double> _vortexSeries = new();
    private readonly System.Diagnostics.Stopwatch _uiRefresh = System.Diagnostics.Stopwatch.StartNew();
    private readonly System.Diagnostics.Stopwatch _rateStopwatch = System.Diagnostics.Stopwatch.StartNew();

    private XYModelSimulator _simulator = null!;
    private IJSObjectReference? _module;
    private DotNetObjectReference<XYModel>? _selfReference;
    private bool _interopReady;
    private bool _running;
    private bool _hotStart = true;
    private bool _showVortices = true;
    private bool _showArrows;
    private int _latticeLength = 128;
    private double _sweepsPerFrame = 1;
    private double _temperature = 0.85;
    private double _completedSweeps;
    private double _sweepsSinceRateSample;
    private double _sweepsPerSecond;
    private double _magnetisation;
    private double _energyPerSite;
    private int _vortexCount;
    private int _antivortexCount;

    private static double KtSliderPercent => (0.893 - 0.05) / (2.5 - 0.05) * 100.0;

    protected override void OnInitialized() => InitialiseSimulator();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Interop.CanvasInterop.EnsureModuleLoadedAsync();
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/isingCanvas.js");
        _selfReference = DotNetObjectReference.Create(this);
        _interopReady = true;

        Interop.CanvasInterop.InitCanvas("xy-canvas", _latticeLength, _latticeLength);
        Interop.CanvasInterop.InitArrowCanvas("xy-arrows", ArrowCanvasSize);
        UpdateObservables();
        RenderLattice();
        await JS.InvokeVoidAsync("renderKatex");
        StateHasChanged();
    }

    private void OnToggleArrows()
    {
        if (_showArrows)
        {
            RenderLattice();
        }
        else if (_interopReady)
        {
            Interop.CanvasInterop.ClearArrows("xy-arrows");
        }
    }

    [JSInvokable]
    public Task OnAnimationFrame()
    {
        var steps = Math.Max(1L, (long)(_sweepsPerFrame * _simulator.TotalSpinsCount));
        _simulator.RunSteps(steps, beta: 1.0 / _temperature);
        _completedSweeps += _sweepsPerFrame;
        _sweepsSinceRateSample += _sweepsPerFrame;

        UpdateObservables();
        RenderLattice();
        SampleSeries();

        if (_rateStopwatch.Elapsed.TotalSeconds > 0.5)
        {
            _sweepsPerSecond = _sweepsSinceRateSample / _rateStopwatch.Elapsed.TotalSeconds;
            _sweepsSinceRateSample = 0;
            _rateStopwatch.Restart();
        }

        if (_uiRefresh.ElapsedMilliseconds > 150)
        {
            _uiRefresh.Restart();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private void InitialiseSimulator()
    {
        _simulator = new XYModelSimulator(_latticeLength, _hotStart);
        _completedSweeps = 0;
        _sweepAxis.Clear();
        _magnetisationSeries.Clear();
        _vortexSeries.Clear();
    }

    private async Task TogglePlay()
    {
        if (_module is null)
        {
            return;
        }

        _running = !_running;
        if (_running)
        {
            await _module.InvokeVoidAsync("startLoop", _selfReference);
        }
        else
        {
            await _module.InvokeVoidAsync("stopLoop");
        }
    }

    private Task StepOnce()
    {
        _simulator.RunSteps(_simulator.TotalSpinsCount, beta: 1.0 / _temperature);
        _completedSweeps += 1;
        UpdateObservables();
        RenderLattice();
        SampleSeries();
        return Task.CompletedTask;
    }

    private void ResetLattice()
    {
        InitialiseSimulator();
        UpdateObservables();
        RenderLattice();
    }

    private void OnSizeChanged(ChangeEventArgs e)
    {
        _latticeLength = int.Parse((string)e.Value!);
        InitialiseSimulator();
        if (_interopReady)
        {
            Interop.CanvasInterop.InitCanvas("xy-canvas", _latticeLength, _latticeLength);
        }

        UpdateObservables();
        RenderLattice();
    }

    private void OnInitChanged(ChangeEventArgs e)
    {
        _hotStart = (string)e.Value! is "true";
        InitialiseSimulator();
        UpdateObservables();
        RenderLattice();
    }

    private void ExportPng()
    {
        if (_interopReady)
        {
            Interop.CanvasInterop.DownloadCanvasPng(
                "xy-canvas",
                $"xy-L{_latticeLength}-T{_temperature:0.000}.png");
        }
    }

    private void UpdateObservables()
    {
        _magnetisation = _simulator.GetMagnetisationMagnitude();
        _energyPerSite = _simulator.GetEnergyPerSite();
        (_vortexCount, _antivortexCount) = _simulator.LocateVortices(_vortexSites, _antivortexSites);
    }

    private void RenderLattice()
    {
        if (!_interopReady)
        {
            return;
        }

        _renderer.RenderPhases(_simulator.Angles);
        if (_showVortices)
        {
            // Crosses through the whole near-KT regime (including just above the
            // transition, where the count fluctuates a lot); fall back to single
            // pixels only once the vortex plasma would truly blot out the field.
            // Density-based so the switch happens at the same visual coverage on
            // every lattice size (~11% of plaquettes carrying a cross), which
            // keeps crosses through the free-vortex regime well above T_KT.
            var drawCross = _vortexCount + _antivortexCount < 0.11 * _latticeLength * _latticeLength;
            _renderer.MarkPlaquettes(_vortexSites, _latticeLength, white: true, drawCross);
            _renderer.MarkPlaquettes(_antivortexSites, _latticeLength, white: false, drawCross);
        }

        Interop.CanvasInterop.RenderFrame("xy-canvas", _renderer.Buffer);

        if (!_showArrows)
        {
            return;
        }

        ComputeVortexArrowField();
        if (_vortexArrowCount > 0)
        {
            Interop.CanvasInterop.DrawVortexArrows(
                "xy-arrows",
                _vortexArrowData.AsSpan(0, _vortexArrowCount * 3),
                _vortexArrowCount,
                (double)ArrowCanvasSize / _latticeLength);
        }
        else
        {
            Interop.CanvasInterop.ClearArrows("xy-arrows");
        }
    }

    // One raw (unaveraged) arrow per site in a window around each vortex and
    // antivortex core, so the phase winding around the core stays visible
    // instead of being smoothed away.
    private void ComputeVortexArrowField()
    {
        var length = _latticeLength;
        var angles = _simulator.Angles;
        var cellPixels = (double)ArrowCanvasSize / length;

        _arrowSitesSeen.Clear();
        _vortexArrowCount = 0;

        AddWindowsAround(_vortexSites);
        AddWindowsAround(_antivortexSites);

        void AddWindowsAround(IReadOnlyList<int> cores)
        {
            foreach (var core in cores)
            {
                var coreX = core % length;
                var coreY = core / length;

                for (var dy = -VortexArrowRadius; dy <= VortexArrowRadius; dy++)
                {
                    for (var dx = -VortexArrowRadius; dx <= VortexArrowRadius; dx++)
                    {
                        if (_vortexArrowCount >= MaxVortexArrows)
                        {
                            return;
                        }

                        var x = ((coreX + dx) % length + length) % length;
                        var y = ((coreY + dy) % length + length) % length;
                        var site = x + y * length;

                        if (!_arrowSitesSeen.Add(site))
                        {
                            continue;
                        }

                        var index = _vortexArrowCount * 3;
                        _vortexArrowData[index] = (x + 0.5) * cellPixels;
                        _vortexArrowData[index + 1] = (y + 0.5) * cellPixels;
                        _vortexArrowData[index + 2] = angles[site];
                        _vortexArrowCount++;
                    }
                }
            }
        }
    }

    private void SampleSeries()
    {
        _sweepAxis.Add(_completedSweeps);
        _magnetisationSeries.Add(_magnetisation);
        _vortexSeries.Add(_vortexCount);

        if (_sweepAxis.Count > SeriesCapacity)
        {
            _sweepAxis.RemoveAt(0);
            _magnetisationSeries.RemoveAt(0);
            _vortexSeries.RemoveAt(0);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _running = false;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopLoop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
