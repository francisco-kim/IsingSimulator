@page "/renormalisation"
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Renormalisation — Ising simulator</PageTitle>

<h1 class="page-title">Block-spin renormalisation</h1>
<p class="page-intro">
    A thermalised lattice is repeatedly coarse-grained with the
    <span data-katex="3\times 3"></span> majority rule (Kadanoff block spins). Each step is a move
    along the <strong>renormalisation group (RG) flow</strong>. Away from
    <span data-katex="T_c"></span> the flow drives the system towards a trivial fixed point: below
    <span data-katex="T_c"></span> the blocks look increasingly ordered
    (<span data-katex="T \to 0"></span>), above <span data-katex="T_c"></span> increasingly random
    (<span data-katex="T \to \infty"></span>). Exactly at <span data-katex="T_c"></span> the flow
    stalls at the critical fixed point — the configuration is statistically self-similar and the
    renormalised lattices look alike at every scale. All panels are drawn at the same display size.
</p>

<div class="sweep-controls">
    <label>
        Temperature
        <select @bind="_temperatureChoice" disabled="@_working">
            <option value="below">T = 2.0 (below T꜀)</option>
            <option value="critical">T = T꜀ ≈ 2.269</option>
            <option value="above">T = 2.35 (just above T꜀)</option>
        </select>
    </label>
    <label>
        Starting lattice
        <select @bind="_startLatticeLength" disabled="@_working">
            <option value="81">81 × 81 (fast)</option>
            <option value="243">243 × 243</option>
            <option value="729">729 × 729 (slow)</option>
            <option value="2187">2187 × 2187 (very slow — minutes)</option>
        </select>
    </label>
    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_working">Thermalise &amp; renormalise</button>
</div>

@if (_working)
{
    <div class="progress-row">
        <div class="progress-track"><div class="progress-fill" style="width:@((_progress * 100).ToString("0"))%"></div></div>
        <span class="progress-status">@_status</span>
    </div>
}

@if (_panelSizes.Count == 0 && !_working)
{
    <p class="rg-example-note">
        Example below: a 2187 × 2187 lattice at the critical temperature
        <span data-katex="T_c \approx 2.269"></span>, coarse-grained step by step. At
        <span data-katex="T_c"></span> the configuration is statistically self-similar — the panels
        look alike at every scale. Press <em>Thermalise &amp; renormalise</em> above to run your own.
    </p>
    <section class="rg-panels">
        @foreach (var (length, index) in ExampleSizes.Select((l, i) => (l, i)))
        {
            <figure class="rg-panel">
                <img src="@($"images/rg-example/rg-{length}.png")" class="lattice-canvas"
                     alt="@($"{length} by {length} block-spin lattice at the critical temperature")" />
                <figcaption>@(index is 0 ? $"{length} × {length} (original)" : $"{length} × {length} — step {index}")</figcaption>
            </figure>
        }
    </section>
}
else
{
    <section class="rg-panels">
        @foreach (var (length, index) in _panelSizes.Select((l, i) => (l, i)))
        {
            <figure class="rg-panel">
                <canvas id="@($"rg-canvas-{index}")" class="lattice-canvas"></canvas>
                <figcaption>@(index is 0 ? $"{length} × {length} (original)" : $"{length} × {length} — step {index}")</figcaption>
            </figure>
        }
    </section>
}

<section class="explainer">
    <h2>Reading the flow: fixed points and the beta function</h2>
    <p>
        Each coarse-graining step is a map on the couplings. At <span data-katex="h = 0"></span> the
        microscopic model has a single coupling <span data-katex="K = J / k_{\mathrm{B}} T"></span>; the
        <span data-katex="3\times 3"></span> majority rule replaces it by an effective coupling
        <span data-katex="K'"></span> on the block lattice,
    </p>
    <div data-katex="K' \;=\; R(K) ," data-katex-display></div>
    <p>
        and that recursion <em>is</em> the RG flow in miniature. Its fixed points
        <span data-katex="K^{*} = R(K^{*})"></span> are scale-invariant — coarse-graining changes nothing —
        and since the correlation length shrinks by the block factor at every step,
    </p>
    <div data-katex="\xi(K') \;=\; \xi(K) / b , \qquad b = 3 ," data-katex-display></div>
    <p>
        a fixed point must have <span data-katex="\xi = 0"></span> or <span data-katex="\xi = \infty"></span>.
        This model has three. Two are trivial, stable sinks — <span data-katex="T \to 0"></span> (all spins
        aligned) and <span data-katex="T \to \infty"></span> (random) — and the flow drives every off-critical
        lattice into one of them, which is exactly what the panels above show step by step. Between them sits
        the <strong>unstable critical fixed point</strong> at <span data-katex="T_c"></span>, with
        <span data-katex="\xi = \infty"></span>: it repels the flow, so only <em>exactly</em> at
        <span data-katex="T_c"></span> do the coarse-grained panels stay statistically self-similar.
    </p>
    <p>
        Linearise the map near the critical fixed point. Write the reduced temperature
        <span data-katex="t = (T - T_c) / T_c"></span> — the one relevant coupling here — which scales under a
        single step by the relevant eigenvalue of <span data-katex="\mathrm{d}R/\mathrm{d}K"></span>,
    </p>
    <div data-katex="t' \;=\; b^{\,y_t}\, t ." data-katex-display></div>
    <p>
        Letting the block factor approach unity turns the discrete recursion into a continuous flow with a
        <strong>beta function</strong> — the same object as in field theory, written here for the temperature
        coupling of this model:
    </p>
    <div data-katex="\beta(t) \;\equiv\; \frac{\mathrm{d}t}{\mathrm{d}\ln b} \;=\; y_t\, t \;=\; \frac{1}{\nu}\, t ." data-katex-display></div>
    <p>
        The beta function is universal: <span data-katex="\beta(g) = \mathrm{d}g / \mathrm{d}\ln(\text{scale})"></span>,
        its sign saying which way a coupling runs and its zeros marking fixed points. Here the scale is the block
        size <span data-katex="b"></span>; in QCD it is energy, and the analogous zero-slope statement is
        asymptotic freedom.
    </p>
    <p>
        It vanishes at the fixed point (<span data-katex="\beta(0) = 0"></span>, i.e. <span data-katex="T_c"></span>)
        and its slope there is the inverse correlation-length exponent, <span data-katex="y_t = 1/\nu"></span>.
        For the 2D Ising model <span data-katex="\nu = 1"></span> exactly (Onsager), so <span data-katex="y_t = 1"></span>
        and integrating the beta function gives
    </p>
    <div data-katex="t(\ell) \;=\; \ell^{\,1/\nu}\, t_0 \;=\; \ell\, t_0 , \qquad \xi \;\sim\; |t|^{-\nu} ." data-katex-display></div>
    <p>
        A tiny departure from <span data-katex="T_c"></span> grows linearly with the scale
        <span data-katex="\ell"></span>: the flow leaves criticality faster the coarser you look, which is why
        the off-critical panels visibly order or randomise as the cascade proceeds. Two honest caveats. First,
        the magnetic field is a second relevant coupling, with <span data-katex="y_h = 15/8"></span>, but it is
        switched off here (<span data-katex="h = 0"></span>), so temperature alone controls the picture. Second,
        a genuine <span data-katex="3\times 3"></span> majority rule does not preserve a single coupling: each
        step generates longer-range and multi-spin terms, so the true flow lives in an infinite-dimensional
        space and <span data-katex="K' = R(K)"></span> is its projection onto the relevant direction. The other,
        irrelevant directions die away under the flow — which is precisely why the one-parameter beta function
        above still captures the universal exponent <span data-katex="\nu"></span>.
    </p>
</section>

@code {
    // Sizes of the pre-rendered example cascade in wwwroot/images/rg-example/.
    private static readonly int[] ExampleSizes = { 2187, 729, 243, 81, 27, 9 };

    private readonly LatticeRenderer _renderer = new();

    private bool _interopReady;
    private bool _working;
    private double _progress;
    private string _status = "";
    private string _temperatureChoice = "critical";
    private int _startLatticeLength = 243;
    private List<int> _panelSizes = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Interop.CanvasInterop.EnsureModuleLoadedAsync();
            _interopReady = true;
            await JS.InvokeVoidAsync("renderKatex");
        }
    }

    private double SelectedTemperature => _temperatureChoice switch
    {
        "below" => 2.0,
        "above" => 2.35,
        _ => ExactIsing2D.CriticalTemperature
    };

    private async Task RunAsync()
    {
        if (!_interopReady || _working)
        {
            return;
        }

        _working = true;
        _panelSizes = new List<int>();
        var temperature = SelectedTemperature;
        var beta = 1.0 / temperature;
        var latticeLength = _startLatticeLength;
        var totalSpins = latticeLength * latticeLength;

        try
        {
            _progress = 0.0;
            _status = $"Thermalising {latticeLength} × {latticeLength} at T = {temperature:0.000} (Wolff)…";
            StateHasChanged();
            await Task.Delay(1);

            // Below T_c the equilibrium is ordered, so start cold (all up): a
            // random start would seed a spanning domain wall that Wolff removes
            // only by curvature-driven coarsening (τ ~ L²), which never finishes
            // in a feasible sweep count at the large lattices. A cold start has
            // no wall, so a handful of Wolff sweeps suffices at every size. At or
            // above T_c there is no wall to remove, so a random hot start is fine.
            var belowTc = temperature < ExactIsing2D.CriticalTemperature;
            var aboveTc = temperature > ExactIsing2D.CriticalTemperature;
            var initialSpins = new List<int>(totalSpins);
            for (var i = 0; i < totalSpins; i++)
            {
                initialSpins.Add(belowTc ? 1 : (Random.Shared.Next(2) is 0 ? 1 : -1));
            }

            // Fast2D keeps only an int[][] (no precomputed per-site neighbour
            // lists), so its memory stays bounded at the large lattice sizes.
            // It uses the J = +1 ferromagnet convention, but at h = 0 that is
            // statistically identical to the rest of the app (J = -1).
            var simulator = new Fast2DIsingMonteCarloSimulator(initialSpins);

            // Sweep budgets by regime. Off-critical (below or above T_c) the
            // correlation length is finite, so equilibration is local and
            // size-independent: a cold below-T_c start only grows thermal
            // fluctuations on an ordered lattice, and an above-T_c start only
            // grows correlations out to the short ξ — both settle in a few Wolff
            // sweeps at every size. At T_c, ξ spans the lattice: this is the hard
            // case, so keep a generous, size-tuned budget (Wolff's near-O(1)
            // autocorrelation lets it shrink as the lattice grows).
            var thermalisationSweeps = belowTc || aboveTc
                ? 30
                : latticeLength switch
                {
                    <= 243 => 200,
                    729 => 110,
                    _ => 70
                };
            var chunkSweeps = Math.Max(1, 1_000_000 / totalSpins);

            var sweepsDone = 0;
            while (sweepsDone < thermalisationSweeps)
            {
                var sweepsThisChunk = Math.Min(chunkSweeps, thermalisationSweeps - sweepsDone);
                simulator.RunMonteCarlo(
                    beta,
                    (long)sweepsThisChunk * totalSpins,
                    SpinUpdateMethod.Wolff,
                    saveLattice: false);

                sweepsDone += sweepsThisChunk;
                _progress = (double)sweepsDone / thermalisationSweeps;
                _status = $"Thermalising {latticeLength} × {latticeLength} at T = {temperature:0.000}: "
                        + $"{sweepsDone}/{thermalisationSweeps} sweeps…";
                StateHasChanged();
                await Task.Delay(1);
            }

            _status = "Coarse-graining (3×3 majority rule)…";
            _progress = 1.0;
            StateHasChanged();
            await Task.Delay(1);

            // Build the cascade, coarse-graining by 3 down to 9 × 9.
            var cascade = new List<List<int>> { simulator.GetSpinConfiguration() };
            var currentLength = latticeLength;
            while (currentLength / 3 >= 9)
            {
                cascade.Add(IsingMonteCarlo.Services.Renormaliser.GenerateRenormalisedLattice(
                    cascade[^1],
                    finalLatticeSizeLimit: 9));
                currentLength /= 3;
            }

            _panelSizes = cascade.Select(spins => (int)Math.Round(Math.Sqrt(spins.Count))).ToList();
            StateHasChanged();
            await Task.Delay(1);

            for (var index = 0; index < cascade.Count; index++)
            {
                var size = _panelSizes[index];
                Interop.CanvasInterop.InitCanvas($"rg-canvas-{index}", size, size);
                _renderer.RenderSpins(cascade[index]);
                Interop.CanvasInterop.RenderFrame($"rg-canvas-{index}", _renderer.Buffer);
            }

            _status = "Done.";
        }
        finally
        {
            _working = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
    }
}
